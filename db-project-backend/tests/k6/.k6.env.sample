# k6 Test Environment Configuration
# Copy this file to .k6.env and update with your values.
# NEVER commit .k6.env — it is gitignored.
#
# To load into your shell before running k6:
#   bash:   export $(grep -v '^#' .k6.env | xargs)
#   PowerShell: Get-Content .k6.env | ForEach-Object { $name, $value = $_.Split('=',2); [Environment]::SetEnvironmentVariable($name, $value, 'Process') }

# API Configuration
API_BASE_URL=http://localhost:5001

# Admin/Police user credentials (JWT auth; must include verify_role handling in scripts)
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-admin-password

# Citizen test account (Supabase auth) — required for crime report submission
CITIZEN_EMAIL=test-citizen@example.com
CITIZEN_PASSWORD=test-citizen-password
