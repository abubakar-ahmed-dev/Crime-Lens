DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres
PORT=5001
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173

# SSL for the database connection (Phase 14). Required for Supabase — leave
# unset/true in production. Set to "false" ONLY for local/CI plain Postgres
# (SSL-with-require against a non-SSL server fails).
DB_SSL=true

JWT_SECRET=replace-with-a-long-random-secret

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database Connection Pool (Phase 1)
DB_POOL_MAX=10
DB_POOL_MIN=0

# Pagination Defaults (Phase 1) — consumed by utils/pagination.js
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200

# Redis (Phase 3) — optional; API degrades gracefully to DB queries if unreachable
REDIS_URL=redis://localhost:6379
# For Redis Cloud (TLS):
# REDIS_URL=rediss://<username>:<password>@<host>:<port>

# Rate Limiting (Phase 4) — Redis-backed; set RATE_LIMIT_ENABLED=false to disable
RATE_LIMIT_ENABLED=true
# Comma-separated IPs that bypass rate limiting (defaults to empty; not even localhost)
# RATE_LIMIT_WHITELIST_IPS=127.0.0.1,::1

# Logging (Phase 7) — pino; defaults to debug (development) / info (production)
# LOG_LEVEL=info
