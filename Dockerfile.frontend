# CrimeLens SPA image (Phase 9).
#
# Build from the repository root:
#   docker build -f Dockerfile.frontend -t crimelens-web .
#
# Stage 1 compiles the Vite bundle. db-project-frontend/.env rides in the
# build context ON PURPOSE: Vite bakes VITE_* variables into the bundle at
# build time, and its values (Supabase URL + anon key) are public by design.
# Stage 2 serves the static bundle from nginx (SPA routing + /api proxy).

FROM node:22-alpine AS builder
WORKDIR /app

# Install all dependencies (vite/tsc are devDependencies and required to build)
COPY db-project-frontend/package.json db-project-frontend/package-lock.json ./
RUN npm ci

COPY db-project-frontend/ ./
RUN npm run build

FROM nginx:1.25-alpine

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

# busybox wget ships with alpine — no extra package needed
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
