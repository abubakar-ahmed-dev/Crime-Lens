# CrimeLens compose-level variables (Phase 9).
#
# Copy to `.env` next to docker-compose.yml (or export before
# `docker compose up`). Only the variables compose itself interpolates live
# here — placeholder values shown; change before any shared/production use.
#
# Application secrets are NOT stored here: the backend reads its full
# configuration from db-project-backend/.env (loaded via env_file; see
# db-project-backend/.env-sample for the documented variable list).

# Grafana admin account (provisioned at first start; change from `admin/admin`)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
