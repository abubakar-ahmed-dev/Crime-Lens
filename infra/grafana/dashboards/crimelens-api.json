{
  "uid": "crimelens-api",
  "title": "CrimeLens API",
  "tags": ["crimelens", "api"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Request rate (5m)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "crimelens-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(crimelens_http_requests_total[5m]))"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 2,
      "title": "Latency p50 / p95 / p99 (5m)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "crimelens-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(crimelens_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(crimelens_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(crimelens_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 3,
      "title": "Error rate (5m)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "crimelens-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(crimelens_http_errors_total[5m])) / clamp_min(sum(rate(crimelens_http_requests_total[5m])), 0.001)",
          "legendFormat": "error ratio"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] }
    },
    {
      "id": 4,
      "title": "Requests by status code",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "crimelens-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_code) (rate(crimelens_http_requests_total[5m]))"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 5,
      "title": "Top routes by latency p95",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "crimelens-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(5, histogram_quantile(0.95, sum by (route, le) (rate(crimelens_http_request_duration_seconds_bucket[5m]))))"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 6,
      "title": "DB pool connections",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "crimelens-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "crimelens_db_pool_connections",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] }
    },
    {
      "id": 7,
      "title": "Redis cache hit rate",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "crimelens-prom" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 24 },
      "targets": [
        { "refId": "A", "expr": "crimelens_cache_hit_rate" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] }
    },
    {
      "id": 8,
      "title": "Component health",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "crimelens-prom" },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 24 },
      "targets": [
        {
          "refId": "A",
          "expr": "crimelens_system_health",
          "legendFormat": "{{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": { "text": "UP", "color": "green" },
                "0": { "text": "DOWN", "color": "red" }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Redis operations (5m)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "crimelens-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation, status) (rate(crimelens_redis_operations_total[5m]))"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 10,
      "title": "Crime reports (increase 1h)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "crimelens-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (increase(crimelens_crimes_reported_total[1h]))"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] }
    },
    {
      "id": 11,
      "title": "Verification decisions (increase 1h)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "crimelens-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (decision) (increase(crimelens_crimes_verified_total[1h]))"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] }
    },
    {
      "id": 12,
      "title": "Node.js memory (heap used)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "crimelens-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "targets": [
        {
          "refId": "A",
          "expr": "nodejs_heap_size_used_bytes"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "id": 13,
      "title": "Event loop lag (seconds)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "crimelens-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "targets": [
        {
          "refId": "A",
          "expr": "nodejs_eventloop_lag_seconds"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    }
  ]
}
