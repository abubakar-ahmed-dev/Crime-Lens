# Production-build overrides (Phase 9, Docker).
#
# `npm run build` / `vite build` runs in production mode and loads this file
# OVER .env — so the containerized SPA talks to its same-origin nginx proxy
# (frontend:80 → backend:5001) instead of hardcoding a host backend URL.
#
# Local dev (`npm run dev`) uses development mode and keeps reading .env
# (http://localhost:5001/api) — unaffected by this file.
VITE_API_BASE_URL=/api
